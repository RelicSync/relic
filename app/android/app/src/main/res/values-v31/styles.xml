<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ ignores windowBackground for the launch splash and draws
         the SplashScreen API surface instead; these attrs give that surface
         Relic's base color (day variant) so it matches Flutter's boot frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
