<resources>
    <!-- The adaptive icon's background layer: the cream tile the shard sits on
         (app/tool/make_app_icon.py TILE). Not a palette surface and not
         day/night aware, because a launcher icon does not follow dark mode. -->
    <color name="ic_launcher_background">#F7F2E7</color>
    <!-- RelicColors.light.base, "Parchment" (app/lib/theme/tokens.dart). The OS
         splash and Flutter's boot frame must paint the SAME color, or launch
         flashes. Keep in lockstep with tokens.dart if the palette ever changes. -->
    <color name="launch_bg">#F5F1E8</color>
</resources>
