<?xml version="1.0" encoding="utf-8"?>
<!-- The foreground is the BARE shard on transparency, sized to sit inside the
     inner 72dp of the 108dp canvas; the cream tile is the background layer, so
     the launcher's mask cuts the cream and never the mark. The monochrome
     layer is the same silhouette for Android 13+ themed icons, which the
     system recolours; API 26-32 ignores the tag. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
