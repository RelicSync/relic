<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Relic syncs with the Worker over HTTPS. Flutter only adds this to the
         debug/profile manifests by default, so release builds would have no
         network at all ("Failed host lookup"). Declare it for all build types. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Scanning a pairing QR to add this device to an existing vault. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- open_filex merges broad media-library permissions Relic never uses:
         we only hand the OS files just decrypted into our own app-private
         temp dir (FileProvider, no permission needed). Play's photo/video
         policy flags them, so strip them from the manifest merge. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="Relic"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share sheet: receive text/links, images, and documents (PDF,
                 doc, zip, octet-stream, ...) shared from other apps
                 (receive_sharing_intent); the capture path stores anything it
                 does not recognize as a file relic. video/* and audio/* are
                 deliberately not declared: _captureShared reads the whole
                 payload into memory, which a movie would not survive — the
                 same policy as the iOS share extension. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="application/*"/>
            </intent-filter>
            <!-- Deep link: the QS tile / an iOS-style Shortcut fire
                 relic://capture to capture the current clipboard (app_links). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="relic"/>
            </intent-filter>
        </activity>

        <!-- Quick Settings tile: pull down the shade and tap to capture the
             current clipboard into Relic (foreground read via the deep link). -->
        <service
            android:name=".RelicCaptureTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_gem"
            android:label="Capture to Relic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: open a relic's link in the browser. Android 11+ hides
             other apps unless we declare we query for a VIEW-able http(s) URL. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
