<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- receive_sharing_intent reads this key to find the App Group container.
	     $(RELIC_APP_GROUP) comes from Flutter/RelicIds.xcconfig, the same file
	     the Runner target reads, so the two can never drift. -->
	<key>AppGroupId</key>
	<string>$(RELIC_APP_GROUP)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Relic</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Relic</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- Photos hands images straight to the extension; movies are not
			     offered because _captureShared reads the whole payload into
			     memory, which a video would not survive. -->
			<key>PHSupportedMediaTypes</key>
			<array>
				<string>Image</string>
			</array>
			<key>NSExtensionActivationRule</key>
			<dict>
				<!-- Selected text / plain text shares. -->
				<key>NSExtensionActivationSupportsText</key>
				<true/>
				<!-- A page URL from Safari (a share sheet only ever carries one). -->
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>1</integer>
				<!-- Photos multi-select; capped so a whole album cannot be shoved
				     through the hand-off in one go. -->
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>10</integer>
				<!-- PDFs and any other document from Files or a document picker. -->
				<key>NSExtensionActivationSupportsFileWithMaxCount</key>
				<integer>10</integer>
			</dict>
		</dict>
		<key>NSExtensionMainStoryboard</key>
		<string>MainInterface</string>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
	</dict>
</dict>
</plist>
